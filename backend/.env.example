# Окружение бэкенда Dubli (скопировать в backend/.env и заполнить).
# .env в git не коммитится.

NODE_ENV=development
PORT=3000
# Уровень логов: trace|debug|log|verbose|warn|error|fatal
LOG_LEVEL=log

# --- База данных (Selectel managed PostgreSQL, сегмент ФЗ-152) ---
# Прод: sslmode=require. Локально SSL можно выключить флагом ниже.
DATABASE_URL=postgres://user:password@localhost:5432/dubli
DATABASE_SSL=false

# --- Шифрование токенов (AES-256-GCM) ---
# Ровно 32 байта в base64. Сгенерировать: openssl rand -base64 32
TOKEN_ENC_KEY=
# env | selectel (сейчас поддерживается env)
KMS_PROVIDER=env

# --- Интеграция amoCRM (приватная интеграция в амоМаркете) ---
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
# Должен совпадать с redirect_uri интеграции (URL до GET /oauth/callback)
AMOCRM_REDIRECT_URI=https://example.com/oauth/callback

# Глобальный фолбэк security_key для вебхуков (приоритет — accounts.settings.security_key)
WEBHOOK_SECURITY_KEY=
# Лимит запросов к amoCRM API на аккаунт (req/s)
AMOCRM_RATE_LIMIT_RPS=7
# Период опроса очереди фоновых сканов (мс). 0 — фоновый процессор выключен.
SCAN_POLL_MS=2000

# Только для e2e: внешний PostgreSQL вместо testcontainers
DATABASE_URL_TEST=

# Секреты для сборки архива виджета-лаунчера «Ko:agency — центр виджетов».
# Скопируйте в .publish.env и заполните. .publish.env в git НЕ коммитится (см. корневой .gitignore).
#
# Оба значения — из карточки приватной интеграции amoCRM:
#   Настройки → Интеграции → ваша интеграция → вкладка «Ключи и доступы».

# «Код интеграции» (машинный id). Менять после создания интеграции нельзя.
WIDGET_CODE=

# «Секретный ключ» интеграции. СЕКРЕТ — не публиковать, не коммитить.
WIDGET_SECRET_KEY=

# Приватная сборка: =1 → из архива убираются публично-маркетплейсные поля
# free/countries (приватный кабинет их может отклонять). Виджет приватный —
# держите =1.
WIDGET_PRIVATE=1

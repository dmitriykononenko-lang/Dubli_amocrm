# Переменные для docker compose. Скопируйте в .env и заполните (в git .env не коммитится).

# --- PostgreSQL (встроенный контейнер db) ---
POSTGRES_USER=dubli
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=dubli

# --- Шифрование токенов (ровно 32 байта в base64): openssl rand -base64 32 ---
# НЕ менять после первого запуска — иначе сохранённые токены не расшифруются.
TOKEN_ENC_KEY=

# --- Приватная интеграция amoCRM ---
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
# Точно как «ссылка для перенаправления» в интеграции:
AMOCRM_REDIRECT_URI=https://dubli.example.com/oauth/callback

# Общий ключ доступа: им авторизуются вебхуки и запросы виджета.
# Этот же ключ впишите в настройки виджета (поле «Ключ безопасности»).
WEBHOOK_SECURITY_KEY=

# --- Бэкапы PostgreSQL (диск эфемерный — дампы обязательно наружу, в S3) ---
BACKUP_DIR=/opt/dubli/backups
BACKUP_KEEP=14
# S3-совместимое хранилище (напр. Selectel S3). Пусто → дамп только локально.
S3_BUCKET=
S3_ENDPOINT=https://s3.ru-1.storage.selcloud.ru
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ru-1

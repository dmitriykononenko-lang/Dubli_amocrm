# Переменные для docker compose. Скопируйте в .env и заполните (в git .env не коммитится).

# --- PostgreSQL (встроенный контейнер db) ---
POSTGRES_USER=dubli
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=dubli

# --- Шифрование токенов (ровно 32 байта в base64): openssl rand -base64 32 ---
# НЕ менять после первого запуска — иначе сохранённые токены не расшифруются.
TOKEN_ENC_KEY=

# --- Приватная интеграция amoCRM ---
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
# Точно как «ссылка для перенаправления» в интеграции:
AMOCRM_REDIRECT_URI=https://dubli.example.com/oauth/callback

# --- Публичная (маркетплейс amoМаркет) интеграция — необязательно ---
# Заполнять, когда виджет публикуется в amoМаркете отдельным (публичным) приложением.
# Пока пусто — работает только приватная интеграция, поведение не меняется.
# ВАЖНО: redirect публичной интеграции в кабинете указать на ОТДЕЛЬНЫЙ путь
# /oauth/callback/public — так бэкенд детерминированно выбирает приложение
# (amoCRM не передаёт client_id в callback). client_secret = secret_key виджета.
PUBLIC_AMOCRM_CLIENT_ID=
PUBLIC_AMOCRM_CLIENT_SECRET=
PUBLIC_AMOCRM_REDIRECT_URI=https://dubli.koagency.ru/oauth/callback/public

# Общий ключ доступа: им авторизуются вебхуки и запросы виджета.
# Этот же ключ впишите в настройки виджета (поле «Ключ безопасности»).
WEBHOOK_SECURITY_KEY=

# --- Бэкапы PostgreSQL (диск эфемерный — дампы обязательно наружу, в S3) ---
BACKUP_DIR=/opt/dubli/backups
BACKUP_KEEP=14
# S3-совместимое хранилище (напр. Selectel S3). Пусто → дамп только локально.
S3_BUCKET=
S3_ENDPOINT=https://s3.ru-1.storage.selcloud.ru
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ru-1

# ============================================================
#  Этап 2 — биллинг / оплата (виджет-вендор Ko:agency)
# ============================================================

# Тариф (по умолчанию как у конкурентов). Итоговую сумму считает бэкенд.
BILLING_PRICE_PER_USER=399
BILLING_MIN_USERS=5

# Аккаунт amoCRM Ko:agency, где ведём клиентов виджета по этапам
# (установил → запросил оплату → оплатил).
VENDOR_AMOCRM_SUBDOMAIN=koagency.amocrm.ru
VENDOR_AMOCRM_ACCOUNT_ID=
# Долгосрочный токен доступа vendor-аккаунта — НАДЁЖНЫЙ способ (как у конкурентов):
# счёт/сделки создаются этим токеном, не завися от переустановки виджета.
# Генерится в koagency: Настройки → Интеграции → ваша интеграция → «Ключи и доступы».
VENDOR_AMOCRM_TOKEN=

# Выделенная воронка «Дубли — клиенты» и её этапы. Достаточно PIPELINE_ID —
# этапы бэкенд найдёт по названию (установ/счет/оплач). Явные ID надёжнее
# (взять из GET /api/v4/leads/pipelines/<pipeline_id> vendor-токеном).
VENDOR_AMOCRM_PIPELINE_ID=11130042
VENDOR_AMOCRM_STATUS_INSTALLED=
VENDOR_AMOCRM_STATUS_REQUESTED=
VENDOR_AMOCRM_STATUS_PAID=
# ID кастом-поля КОМПАНИИ «ID аккаунта amo|kommo» клиента (у koagency = 1173679).
VENDOR_AMOCRM_ACCOUNT_FIELD_ID=
# ID кастом-поля КОМПАНИИ «Ссылка на аккаунт» (у koagency = 1195091) — пишем URL клиента.
VENDOR_AMOCRM_ACCOUNT_LINK_FIELD_ID=

# ЮKassa (онлайн-оплата) — включается, когда заданы оба ключа магазина.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Куда вернуть пользователя после оплаты (страница «спасибо»/кабинет).
BILLING_RETURN_URL=https://dubli.koagency.ru
# Фискализация (54-ФЗ). true → в платёж добавляется чек (нужен email покупателя,
# его вводят на вкладке «Оплата»). Для магазина с онлайн-кассой должно быть true.
YOOKASSA_FISCAL=true
# Ставка НДС в чеке: 1=без НДС (УСН), 2=0%, 3=10%, 4=20%, 5=10/110, 6=20/120.
YOOKASSA_VAT_CODE=1

# --- Вендор-управление подписками (виджет «Внешняя оплата»: даты храним у себя) ---
# Токен доступа к /vendor/billing/* (заголовок X-Vendor-Token). Длинный случайный;
# без него vendor-роуты закрыты (401). Сгенерировать: openssl rand -hex 32
VENDOR_ADMIN_TOKEN=
# Пробный период (дней от установки виджета). По умолчанию 7.
BILLING_TRIAL_DAYS=7
# Льгота после paid_till для трека «счёт» (банковский перевод юрлица идёт 1–3 дня).
BILLING_INVOICE_GRACE_DAYS=5
# Карта-рекуррент (фаза 4): за сколько дней до paid_till списывать; дни ретраев dunning.
BILLING_RENEW_LEAD_DAYS=3
BILLING_DUNNING_RETRIES=1,3,5
# Напоминания (фаза 3): за сколько дней до paid_till; вебхук уведомлений вендору.
BILLING_NOTIFY_LEAD_DAYS=5
BILLING_NOTIFY_TELEGRAM_WEBHOOK=
# Стадийное подтверждение счёта: в koagency настроить вебхук смены стадии сделки на
#   https://dubli.koagency.ru/vendor/billing/webhook/amocrm-paid?key=<WEBHOOK_SECURITY_KEY>
# Стадию «Оплачен» задаёт VENDOR_AMOCRM_STATUS_PAID (см. секцию vendor-amoCRM выше).

# Вендор-панель /vendor/panel (логин оператора, роль billing_admin). Отдельно от
# VENDOR_ADMIN_TOKEN — его в браузер не кладём. Пусто → вход по паролю выключен.
BILLING_ADMIN_USER=
BILLING_ADMIN_PASSWORD=
# Секрет подписи сессионной cookie. Пусто → используется VENDOR_ADMIN_TOKEN.
BILLING_ADMIN_SESSION_SECRET=
# Авто-сверка поступлений по счетам (фаза 5). Выкл по умолчанию — старт с ручного/стадийного
# подтверждения. Включить → банк/Adesk шлёт входящие платежи на
#   https://dubli.koagency.ru/vendor/billing/webhook/bank-incoming?key=<WEBHOOK_SECURITY_KEY>
# (матчинг по номеру счёта DUB-… из назначения; несматченные — в ручной разбор).
BILLING_BANK_RECONCILE=false

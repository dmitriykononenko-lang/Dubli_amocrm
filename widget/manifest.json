{
  "widget": {
    "name": "widget.name",
    "description": "widget.description",
    "short_description": "widget.short_description",
    "version": "1.0.3",
    "interface_version": 2,
    "init_once": false,
    "locale": ["ru", "en"],
    "installation": true,
    "oauth": "Y",
    "support": {
      "link": "https://github.com/dmitriykononenko-lang/Dubli_amocrm",
      "email": "partnerskoda@gmail.com"
    }
  },
  "locations": [
    "settings",
    "advanced_settings"
  ],
  "settings": {
    "backend_url": {
      "name": "settings.backend_url",
      "type": "text",
      "required": false
    },
    "security_key": {
      "name": "settings.security_key",
      "type": "text",
      "required": false
    }
  },
  "advanced": {
    "default_entity": {
      "name": "advanced.default_entity",
      "type": "list",
      "values": {
        "contact": "settings.contacts",
        "company": "settings.companies",
        "lead": "settings.leads"
      },
      "default": "contact"
    }
  }
}

# Секреты для сборки архива виджета. Скопируйте в .publish.env и заполните.
# .publish.env в git НЕ коммитится (см. корневой .gitignore).
#
# Оба значения — из кабинета разработчика amoCRM:
#   Настройки → Интеграции → ваша интеграция «Дубли» → вкладка «Ключи и доступы».

# «Код интеграции» (виден в кабинете, машинный id интеграции). Менять после
# создания интеграции нельзя.
WIDGET_CODE=

# «Секретный ключ» интеграции. СЕКРЕТ — не публиковать, не коммитить.
WIDGET_SECRET_KEY=

{# Матрица «поле × сотрудник». Клик по ячейке циклически меняет режим. #}
<div class="hf-matrix-wrap">
  <div class="hf-brand" style="display:flex;align-items:center;gap:10px;margin:0 0 14px;padding:12px 16px;background:#e30613;color:#fff;border-radius:4px;font-weight:bold;font-size:16px;letter-spacing:1px;">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="display:block;flex-shrink:0;">
      <rect x="2" y="3" width="6.5" height="6.5" rx="1.2" stroke="#fff" stroke-width="2"/>
      <path d="M3.4 6.2l1.6 1.6L8 4.6" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <rect x="2" y="14" width="6.5" height="6.5" rx="1.2" stroke="#fff" stroke-width="2"/>
      <line x1="12" y1="6.2" x2="22" y2="6.2" stroke="#fff" stroke-width="2" stroke-linecap="round"/>
      <line x1="12" y1="17.2" x2="19" y2="17.2" stroke="#fff" stroke-width="2" stroke-linecap="round"/>
    </svg>
    <span>KO:AGENCY</span>
    <span style="font-weight:normal;font-size:13px;opacity:.85;margin-left:auto;">Скрытие полей</span>
  </div>
  <div class="hf-legend">
    O — открыть · S — скрыть · * — звёздочки · B — блокировать · V — воронка
  </div>

  <table class="js-hf-matrix hf-matrix">
    <thead>
      <tr>
        <th class="hf-corner">Поле \ Сотрудник</th>
        {% for user in meta.users %}
          <th class="hf-user">
            <div class="hf-user__name">{{ user.name }}</div>
            <div class="hf-col-modes">
              {% for m in modes %}
                <span class="js-hf-col-mode hf-mode-btn" data-mode="{{ m }}">{{ m }}</span>
              {% endfor %}
            </div>
          </th>
        {% endfor %}
      </tr>
    </thead>
    <tbody>
      {% for field in meta.fields %}
        <tr>
          <th class="hf-field">
            <span class="hf-field__name">{{ field.name }}</span>
            <span class="hf-field__entity">{{ field.entity }}</span>
            <span class="hf-row-modes">
              {% for m in modes %}
                <span class="js-hf-row-mode hf-mode-btn" data-mode="{{ m }}">{{ m }}</span>
              {% endfor %}
            </span>
          </th>
          {% for user in meta.users %}
            {% set key = field.id ~ ':' ~ user.id %}
            {% set val = meta.matrix[key] | default('O') %}
            <td>
              <span class="js-hf-cell hf-cell"
                    data-key="{{ key }}"
                    data-field="{{ field.id }}"
                    data-user="{{ user.id }}"
                    data-mode="{{ val }}">{{ val }}</span>
            </td>
          {% endfor %}
        </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="hf-actions">
    <button class="js-hf-save button-input button-input_blue">Сохранить</button>
  </div>
</div>

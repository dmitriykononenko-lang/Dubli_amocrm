# Reverse-proxy с TLS перед бэкендом Dubli (порт 3000 слушает только localhost).
# TLS-сертификат: certbot --nginx -d dubli.example.com  (Let's Encrypt).
# amoCRM ходит на /oauth/callback и /webhooks/amo; /api вызывает виджет из браузера
# (CORS для доменов amoCRM/Kommo уже настроен в самом бэкенде).

server {
    listen 80;
    server_name dubli.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name dubli.example.com;

    ssl_certificate     /etc/letsencrypt/live/dubli.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dubli.example.com/privkey.pem;

    # amoCRM шлёт вебхуки form-urlencoded; небольшой запас на тело.
    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
